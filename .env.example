# Local-only environment file. Never commit real keys — .env is gitignored.
# These same names are injected automatically in production by Vercel runtime
# environment variables (Project → Settings → Environment Variables).

# Secret key from https://dashboard.stripe.com/test/apikeys (use sk_test_... locally)
STRIPE_SECRET_KEY=

# Publishable key — safe to expose to the browser (pk_test_... locally)
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret from the Stripe CLI for local testing:
#   stripe listen --forward-to localhost:3000/api/webhook
# (in production this is the endpoint's signing secret from the Stripe dashboard)
STRIPE_WEBHOOK_SECRET=
